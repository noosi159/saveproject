<!-- Container ทั้งหน้า -->
<div 
  class="relative min-h-screen flex justify-center items-center bg-white"
  style="background: linear-gradient(to bottom, #FECDDF 0%,#FFFFFF 50%,#FFFFFF 70%,#FFFFFF 100%)"
>

  <!-- Wave Background SVG -->
  <svg class="absolute bottom-0 left-0 w-full z-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320">
    <defs>
      <linearGradient id="gradient" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#FEE0DA" />
        <stop offset="100%" stop-color="#FFFFFF" />
      </linearGradient>
    </defs>
    <path
      fill="url(#gradient)"
      fill-opacity="1"
      d="M0,0L40,42.7C80,85,160,171,240,197.3C320,224,400,192,480,154.7C560,117,640,75,720,74.7C800,75,880,117,960,154.7C1040,192,1120,224,1200,213.3C1280,203,1360,149,1400,122.7L1440,96L1440,320L1400,320C1360,320,1280,320,1200,320C1120,320,1040,320,960,320C880,320,800,320,720,320C640,320,560,320,480,320C400,320,320,320,240,320C160,320,80,320,40,320L0,320Z"
    ></path>
  </svg>

  <!-- Logo -->
  <div class="absolute bottom-4 left-6 z-0">
    <img src="/logo.png" alt="aji" class="w-24 h-24" />
  </div>

  <!-- Form Container (Card) -->
<div class="flex justify-center self-center z-10">
    <div class="p-12 bg-white mx-auto rounded-3xl w-full max-w-2xl shadow-xl  mt-8 mb-8">
      <div class="mb-7">
        <h2 class="mb-4 text-xl font-bold leading-tight tracking-tight text-gray-900 md:text-2xl dark:text-white">
          Change Password
        </h2>

        <form [formGroup]="form" (ngSubmit)="onSubmit()" class="space-y-5">
          <div>
            <label for="email" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Your email</label>
            <input 
              pInputText 
              formControlName="email" 
              type="email" 
              id="email" 
              placeholder="name@live.rmutl.ac.th"
              class="w-full px-4 py-2 border border-gray-300 rounded-md"
            />
            <p-message
              *ngIf="form.controls['email'].invalid && form.controls['email'].touched"
              severity="error"
              text="Valid email is required.">
            </p-message>
          </div>

          <div>
            <label for="password" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">New Password</label>
            <input 
              pInputText 
              formControlName="password" 
              type="password" 
              id="password" 
              placeholder="••••••••"
              class="w-full px-4 py-2 border border-gray-300 rounded-md"
            />
            <p-message 
              *ngIf="form.controls['password'].invalid && form.controls['password'].touched"
              severity="error"
              text="Password is required.">
            </p-message>
          </div>

          <div>
            <label for="confirmPassword" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Confirm Password</label>
            <input 
              pInputText 
              formControlName="confirmPassword" 
              type="password" 
              id="confirmPassword" 
              placeholder="••••••••"
              class="w-full px-4 py-2 border border-gray-300 rounded-md"
            />
            <p-message 
              *ngIf="form.errors?.['passwordMismatch'] && form.controls['confirmPassword'].touched"
              severity="error"
              text="Passwords do not match.">
            </p-message>
          </div>

          <div class="flex items-start">
            <p-checkbox inputId="terms" formControlName="acceptTerms" binary="true"></p-checkbox>
            <label for="terms" class="ml-2 text-sm text-gray-500 dark:text-gray-300">
              I accept the 
              <a href="#" class="font-medium text-primary-600 hover:underline dark:text-primary-500">
                Terms and Conditions
              </a>
            </label>
          </div>

          <button 
            pButton 
            type="submit" 
            label="Reset Password" 
            class="w-full" 
            [disabled]="form.invalid">
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
